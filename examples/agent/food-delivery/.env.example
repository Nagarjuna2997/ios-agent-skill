# Your Supabase project URL (https://<project>.supabase.co)
# Get it: https://supabase.com/dashboard: Project Settings > API
# Client key: embedded in the app bundle through Secrets.xcconfig.
SUPABASE_URL=

# Your project's anon (public) key; protect data with row-level security
# Get it: https://supabase.com/dashboard: Project Settings > API
# Client key: embedded in the app bundle through Secrets.xcconfig.
SUPABASE_ANON_KEY=

# Base URL of your API, for example https://api.example.com/v1
# Get it: Your server or hosting provider
# Client key: embedded in the app bundle through Secrets.xcconfig.
API_BASE_URL=

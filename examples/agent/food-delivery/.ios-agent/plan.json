  "capabilities": [
    {
      "id": "launch-screen",
      "reason": "Launch screen and animated logo splash into the app."
    },
    {
      "id": "lottie-animation",
      "reason": "Optional richer logo animation on the splash screen."
    },
    {
      "id": "accessibility-baseline",
      "reason": "44 pt tap targets, Reduce Motion aware animation and Dynamic Type spacing."
    },
    {
      "id": "sign-in-with-apple",
      "reason": "Sign in with Apple is required alongside the email option."
    },
    {
      "id": "email-password-auth",
      "reason": "Email and password sign up and sign in."
    },
    {
      "id": "keychain-storage",
      "reason": "Stores the session securely on the device."
    },
    {
      "id": "mapkit-map",
      "reason": "Shows restaurants as markers on a map."
    },
    {
      "id": "location-services",
      "reason": "Sorts restaurants by distance from the user's current location."
    },
    {
      "id": "url-session-networking",
      "reason": "Loads restaurants and menus and submits orders."
    },
    {
      "id": "rest-api-client",
      "reason": "Points the app at the restaurant and order server once its address is supplied."
    },
    {
      "id": "swiftdata",
      "reason": "Keeps the cart and order history across relaunches."
    },
    {
      "id": "storekit2-paywall",
      "reason": "Closest module for StoreKit purchases at checkout (not a subscription; needs adapting)."
    },
    {
      "id": "live-activity",
      "reason": "Shows delivery progress on the Lock Screen and Dynamic Island."
    },
    {
      "id": "local-notifications",
      "reason": "Alerts the user when the order status changes."
    },
    {
      "id": "websocket-realtime",
      "reason": "Live order status updates from the server (no built module yet)."
    },
    {
      "id": "swift-charts-dashboard",
      "reason": "Spending stats and trends on the past orders dashboard."
    },
    {
      "id": "haptics",
      "reason": "Feedback on add to cart and successful payment."
    },
    {
      "id": "appearance-settings",
      "reason": "Light, dark or system appearance choice."
    },
    {
      "id": "app-icon",
      "reason": "Provides the app icon."
    },
    {
      "id": "color-assets",
      "reason": "Brand colors with light and dark variants."
    },
    {
      "id": "privacy-manifest",
      "reason": "Required privacy declarations before App Store submission."
    }
  ],
  "features": [
    "Animated logo splash",
    "Sign in with Apple and email/password",
    "Restaurant list with map toggle and distance sorting",
    "Restaurant menus",
    "Persistent cart with quantity editing",
    "StoreKit checkout",
    "Live Activity order tracking on Lock Screen and Dynamic Island",
    "Order status change notifications",
    "Past orders dashboard with spending charts",
    "Light/dark appearance setting"
  ],
  "assumptions": [
    "StoreKit 2 is used for checkout because it was requested; real food orders normally require Apple Pay or a card processor under App Store rules, so this should be reviewed before release.",
    "A server of your own supplies restaurants, menus and order status; sample data is used until its address is set.",
    "Live order status is simulated locally until a real-time server is connected.",
    "Sign in with Apple and email accounts are both available and the session is kept in the Keychain.",
    "Cart and order history are stored on the device only, with no iCloud sync.",
    "The Account screen is the fifth top-level tab; the splash, sign-in, menu and checkout screens are not tabs.",
    "Delivery is to a single saved address entered at checkout."
  ]
}

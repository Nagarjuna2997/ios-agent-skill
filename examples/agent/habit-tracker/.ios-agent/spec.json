{
  "version": 1,
  "name": "HabitTracker",
  "displayName": "Habit Tracker",
  "bundleId": "com.example.habittracker",
  "deploymentTarget": "17.0",
  "swiftVersion": "6.0",
  "entitlements": {},
  "infoPlist": {
    "UILaunchScreen": {
      "UIColorName": "LaunchBackground",
      "UIImageName": "LaunchLogo",
      "UIImageRespectsSafeAreaInsets": true
    }
  },
  "packages": [],
  "buildSettings": {},
  "secrets": [],
  "capabilities": [
    "swiftdata",
    "appearance-settings",
    "accessibility-baseline",
    "haptics",
    "color-assets",
    "design-system",
    "app-icon",
    "launch-screen"
  ],
  "sourceExcludes": [
    "Resources/IconLayers/**"
  ],
  "appIconName": "AppIcon"
}

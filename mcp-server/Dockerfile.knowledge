FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY mcp-server/package*.json ./mcp-server/
RUN cd mcp-server && npm ci
COPY mcp-server ./mcp-server
COPY docs ./docs
RUN cd mcp-server && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /src/mcp-server/package.json ./
COPY --from=build /src/mcp-server/node_modules ./node_modules
COPY --from=build /src/mcp-server/dist ./dist
COPY --from=build /src/mcp-server/data ./data
USER node
EXPOSE 3000
CMD ["node", "dist/knowledge-server.js", "--http", "--host", "0.0.0.0", "--port", "3000"]

{
  "name": "ios-agent-mcp",
  "version": "2.10.0",
  "description": "MCP server for modern iOS/Swift development — concurrency isolation, architecture boundaries, SwiftUI, and App Store readiness analysis",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ios-agent-mcp": "dist/unified.js",
    "ios-agent-knowledge": "dist/knowledge-server.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "mcp.json",
    "README.md",
    "data"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && node scripts/bundle-knowledge.mjs && node scripts/bundle-capabilities.mjs && tsc",
    "test": "node --test test/*.test.js",
    "typecheck": "node scripts/sync-version.mjs && node scripts/bundle-knowledge.mjs && node scripts/bundle-capabilities.mjs && tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ios",
    "swift",
    "swiftui",
    "claude",
    "cursor",
    "chatgpt",
    "codex",
    "gemini",
    "apple-documentation",
    "icon-composer"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nagarjuna2002/ios-agent": "0.4.0",
    "@nagarjuna2002/ios-simulator-mcp": "0.2.0",
    "@resvg/resvg-js": "2.6.2",
    "fast-xml-parser": "5.11.1",
    "fontkit": "2.0.4",
    "jpeg-js": "0.4.4",
    "plist": "5.0.0",
    "pngjs": "7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fontkit": "2.0.8",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "typescript": "^5.6.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nagarjuna2997/ios-agent-skill.git",
    "directory": "mcp-server"
  },
  "homepage": "https://nagarjuna2997.github.io/ios-agent-skill/",
  "bugs": {
    "url": "https://github.com/Nagarjuna2997/ios-agent-skill/issues"
  },
  "mcpName": "io.github.Nagarjuna2997/ios-agent-skill"
}

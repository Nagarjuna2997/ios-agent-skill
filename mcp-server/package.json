{
  "name": "ios-agent-mcp",
  "version": "1.0.0",
  "description": "MCP server for modern iOS/Swift development \u2014 concurrency isolation, architecture boundaries, SwiftUI, and App Store readiness analysis",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ios-agent-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "mcp.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ios",
    "swift",
    "swiftui",
    "claude",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nagarjuna2997/ios-agent-skill.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/Nagarjuna2997/ios-agent-skill/tree/main/mcp-server",
  "bugs": {
    "url": "https://github.com/Nagarjuna2997/ios-agent-skill/issues"
  }
}
